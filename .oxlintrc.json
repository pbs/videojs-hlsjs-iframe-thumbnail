{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "ignorePatterns": ["dist", "dist-demo", "node_modules"],
  "overrides": [
    {
      "files": ["**/tests/**"],
      "rules": {
        "typescript/no-extraneous-class": "off"
      }
    }
  ]
}
